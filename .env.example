# Public address of the site, no trailing slash. Search engines are blocked until this is set.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Hostinger mailbox that sends enquiry emails (create it in hPanel > Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=enquiry@example.com
SMTP_PASS=

# Inbox that receives enquiries. Defaults to SMTP_USER when empty.
ENQUIRY_TO=
